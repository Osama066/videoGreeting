# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai_video_greeting

# ElevenLabs API Settings (Purchased TTS API)
# API Key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Cloned Voice ID from: https://elevenlabs.io/app/voice-lab
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here

# Cloudinary Credentials (Free Tier Media Storage)
# From: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Modal Wav2Lip Serverless Webhook URL
# Generated after running `python -m modal deploy app.py` inside modal-wav2lip
MODAL_WAV2LIP_ENDPOINT=https://your-username--ai-greeting-wav2lip-generate.modal.run
